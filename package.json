{
  "name": "yunzai-llm-plugin",
  "version": "2.0.0",
  "description": "Yunzai-Bot LLM 智能对话插件：多协议(OpenAI/Anthropic/Gemini)、额度控制、表情包、工具调用、自然语言转指令",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup && node cli/build-web.mjs",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/",
    "sandbox": "node sandbox/run.mjs",
    "config": "node cli/config.mjs",
    "exec-setup": "node cli/exec-setup.mjs",
    "computer-setup": "node cli/computer-setup.mjs",
    "lens-setup": "node cli/lens-setup.mjs",
    "rustdesk-setup": "node cli/rustdesk-setup.mjs",
    "agy-setup": "node cli/agy-setup.mjs"
  },
  "keywords": [
    "yunzai",
    "yunzai-bot",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "marked": "18.1.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "yaml": "^2.7.0"
  }
}
